# Skip dependency install scripts (supply-chain hardening). Explicit commands like npm run build still run.
# The accessibility scan (npm run a11y) needs chromedriver's download script, once: npm rebuild chromedriver --ignore-scripts=false
ignore-scripts=true

# Install only versions published at least this many days ago (supply-chain hardening); matches the
# Dependabot cooldown in .github/dependabot.yml. Exclude a package with min-release-age-exclude.
min-release-age=3
